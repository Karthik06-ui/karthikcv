# Copy this file to .env and fill in real values for local or production use.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave blank locally to use SQLite (backend/db.sqlite3).
# Set to your PostgreSQL connection string in production (Render provides DATABASE_URL).
DATABASE_URL=

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Resend email configuration (server-side only)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>
CONTACT_RECEIVER_EMAIL=your-resend-signup-email@example.com
AUTO_REPLY_ENABLED=False
